<UserControl x:Class="SetupSwitch.App.ProfilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button x:Name="NewButton" DockPanel.Dock="Right" Content="Novo perfil" Click="OnNew" />
                    <TextBlock Text="Perfis" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="ProfileList" SelectionChanged="OnSelectionChanged"
                             MouseDoubleClick="OnApply" HorizontalContentAlignment="Stretch" />
                    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Nenhum perfil ainda. Monte uma combinação ao lado e salve." />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="DeleteButton" Content="Excluir" Margin="0,0,8,0" Click="OnDelete" />
                    <Button x:Name="SaveButton" Content="Salvar" Margin="0,0,8,0" Click="OnSave" />
                    <Button x:Name="ApplyButton" Content="Aplicar perfil" Click="OnApply" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle" FontSize="14" FontWeight="SemiBold" />

                        <TextBlock Text="Nome" Style="{StaticResource Field}" />
                        <TextBox x:Name="NameBox" TextChanged="OnNameChanged" />

                        <TextBlock Text="Telas" Style="{StaticResource Field}" />
                        <ComboBox x:Name="ScreensBox" SelectionChanged="OnScreensChanged" />
                        <CheckBox x:Name="RecaptureBox" Content="Guardar de novo o layout de agora" Margin="0,8,0,0" />

                        <TextBlock Text="Saída de áudio" Style="{StaticResource Field}" />
                        <ComboBox x:Name="OutputBox" />

                        <TextBlock Text="Entrada de áudio" Style="{StaticResource Field}" />
                        <ComboBox x:Name="InputBox" />

                        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
